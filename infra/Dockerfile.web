FROM node:22-alpine AS base
WORKDIR /app

COPY web/package.json web/package-lock.json ./
RUN npm ci

COPY web/ .

# Development target — hot reload via tsx watch
FROM base AS dev
EXPOSE 3000
CMD ["npm", "run", "dev"]

# Production target — build and run compiled JS
FROM base AS prod
RUN npm run build
RUN npm prune --omit=dev
EXPOSE 3000
CMD ["npm", "start"]
